# Brewfile — install everything with:  brew bundle
#
# Run from the repo root. Homebrew is required:
#   https://brew.sh

# --- Shell ------------------------------------------------------------------
brew "zsh"
brew "starship"                 # cross-shell prompt (see .config/starship.toml)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# --- CLI tools --------------------------------------------------------------
brew "gh"                       # GitHub CLI (used for HOMEBREW_GITHUB_API_TOKEN)
brew "fzf"                      # fuzzy finder
brew "neovim"                   # aliased to vi/vim in .zshrc
brew "tree"
brew "htop"

# --- Languages & version managers -------------------------------------------
brew "go"
brew "node"                     # provides npm
brew "pnpm"
brew "rbenv"
brew "openjdk@21"
